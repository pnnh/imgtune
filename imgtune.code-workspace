{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"git.openRepositoryInParentFolders": "never",
		"files.exclude": {
			"**/.git": true
		},
		"chat.tools.terminal.autoApprove": {
			"rtk": true,
			"bd": true,
			"cmake": true,
			"mkdir": true,
			"tar": true,
			"sqlite3": true,
			"pnpm": true,
			"/^bash \\.specify/scripts/bash/check-prerequisites\\.sh --json --paths-only 2>&1$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/^bash \\.specify/scripts/bash/setup-plan\\.sh --json 2>&1$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/^bash \\.specify/scripts/bash/setup-tasks\\.sh --json 2>&1$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/^bash \\.specify/scripts/bash/check-prerequisites\\.sh --json --require-tasks --include-tasks 2>&1$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/^bash \\.specify/scripts/bash/check-prerequisites\\.sh --json 2>&1$/": {
				"approve": true,
				"matchCommandLine": true
			}
		},
		"search.useIgnoreFiles": false,
		"search.exclude": {
			"tsconfig.tsbuildinfo": true,
			"build/**": true,
			"**/node_modules/**": true,
			"**/target/**": true,
			"**/.dolt/**": true,
			"**/.vscode/**": true,
			"**/.next/**": true,
			"**/.beads/**": true,
			"**/.idea/**": true,
		}
	}
}