{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "dist-server",
        "rootDir": "src/server"
    },
    "include": [
        "src/server/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}